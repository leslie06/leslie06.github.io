{
  "name": "kart-new",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && rm -rf ../kart-new/assets && mkdir -p ../kart-new && cp -R dist/. ../kart-new/",
    "assets:convert": "node scripts/convert-assets.mjs",
    "size": "node scripts/report-build.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@types/howler": "^2.2.13",
    "howler": "^2.2.4",
    "lil-gui": "^0.21.0",
    "postprocessing": "^6.39.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
