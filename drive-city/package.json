{
  "name": "drive-city",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "shot": "node scripts/shot.mjs",
    "deploy": "node scripts/deploy.mjs",
    "blender-addon": "cd scripts/blender/bcity_landmark && rm -f ../bcity_landmark.zip && zip -qX ../bcity_landmark.zip blender_manifest.toml __init__.py && echo scripts/blender/bcity_landmark.zip"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "meshoptimizer": "^1.3.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
