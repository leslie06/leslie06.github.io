{
  "version": 1,
  "_note": "NPC 语音台词表（第一批）。每句的合成指令 = archetypes[原型].style + 本句 instruct（对要求固定格式的音色，则只用 emotion 字段）。archetypes[].voices 先留空，需从 tts.voiceListUrl 的 cosyvoice-v3.5-plus 音色列表里按 voiceHint 挑选填入，不同模型的音色不能混用。文本里用省略号制造停顿，用儿化音和语气词保持京味儿。",

  "tts": {
    "provider": "aliyun-bailian",
    "model": "cosyvoice-v3.5-plus",
    "format": "mp3",
    "sampleRate": 24000,
    "variantsDefault": 3,
    "languageHints": ["zh"],
    "voiceListUrl": "https://help.aliyun.com/zh/model-studio/cosyvoice-voice-list",
    "emotions": ["neutral", "fearful", "angry", "sad", "surprised", "happy", "disgusted"]
  },

  "playback": {
    "_note": "游戏内播放参数。每个 NPC 实例在原型的 rateRange 里取一个固定速率，播放时再叠加 rateJitter 的随机。",
    "rateJitter": 0.05,
    "refDistance": 4,
    "maxDistance": 45,
    "rolloffFactor": 1.5,
    "maxConcurrentSpeakers": 3,
    "noRepeatLastVariants": 2
  },

  "triggers": {
    "near_miss":   { "desc": "车从身边擦过",             "priority": 2, "cooldownSec": 4 },
    "bumped":      { "desc": "被玩家或车轻撞、推搡",     "priority": 2, "cooldownSec": 3 },
    "hit":         { "desc": "被车撞倒",                 "priority": 4, "cooldownSec": 0 },
    "aimed":       { "desc": "被武器瞄准",               "priority": 3, "cooldownSec": 5 },
    "gunshot":     { "desc": "附近有枪声或爆炸",         "priority": 3, "cooldownSec": 6 },
    "car_stolen":  { "desc": "自己的车被抢（司机/车主）", "priority": 4, "cooldownSec": 0 },
    "honk":        { "desc": "司机被挡路、被别车",       "priority": 1, "cooldownSec": 6 },
    "police_call": { "desc": "报警，播完触发通缉加星",   "priority": 3, "cooldownSec": 0 },
    "greet":       { "desc": "玩家走近或慢速路过",       "priority": 0, "cooldownSec": 10 },
    "idle":        { "desc": "无事时自言自语",           "priority": 0, "cooldownSec": 15 }
  },

