  "lines": [
    { "id": "uncle_near_miss_01", "archetype": "uncle", "trigger": "near_miss", "emotion": "angry", "text": "哎哟喂！您这是奔命去啊？", "instruct": "愤怒地大声呵斥。" },
    { "id": "uncle_near_miss_02", "archetype": "uncle", "trigger": "near_miss", "emotion": "angry", "text": "嘿！长没长眼呐！", "instruct": "气得嗓门都劈了。" },
    { "id": "uncle_bumped_01", "archetype": "uncle", "trigger": "bumped", "emotion": "angry", "text": "干嘛呢干嘛呢，没瞧见这儿有人呐？", "instruct": "不满地质问。" },
    { "id": "uncle_hit_01", "archetype": "uncle", "trigger": "hit", "emotion": "sad", "text": "哎哟……我的老腰……", "instruct": "痛苦地呻吟，气若游丝。", "variants": 4 },
    { "id": "uncle_aimed_01", "archetype": "uncle", "trigger": "aimed", "emotion": "fearful", "text": "别别别，有话好好说，我这把老骨头经不起折腾……", "instruct": "害怕，声音发颤。" },
    { "id": "uncle_gunshot_01", "archetype": "uncle", "trigger": "gunshot", "emotion": "fearful", "text": "这是放炮还是怎么着？快走快走！", "instruct": "慌张地催促。" },
    { "id": "uncle_idle_01", "archetype": "uncle", "trigger": "idle", "emotion": "neutral", "text": "这天儿，热得邪乎。", "instruct": "慢悠悠地自言自语。" },
    { "id": "uncle_idle_02", "archetype": "uncle", "trigger": "idle", "emotion": "disgusted", "text": "现在这年轻人，开车跟不要命似的。", "instruct": "嘀嘀咕咕地抱怨。" },
    { "id": "uncle_greet_01", "archetype": "uncle", "trigger": "greet", "emotion": "happy", "text": "吃了吗您呐？", "instruct": "热情地打招呼。" },
    { "id": "uncle_police_01", "archetype": "uncle", "trigger": "police_call", "emotion": "angry", "text": "喂，一一零吗？四环这儿有人开车撞人！", "instruct": "对着电话气愤地喊。" },

    { "id": "auntie_near_miss_01", "archetype": "auntie", "trigger": "near_miss", "emotion": "surprised", "text": "哎哟我的妈呀！吓死我了！", "instruct": "受惊后尖叫。" },
    { "id": "auntie_near_miss_02", "archetype": "auntie", "trigger": "near_miss", "emotion": "angry", "text": "你有病啊！差点儿撞着我！", "instruct": "跳着脚骂。" },
    { "id": "auntie_bumped_01", "archetype": "auntie", "trigger": "bumped", "emotion": "angry", "text": "哎你这人怎么走路的！", "instruct": "大声埋怨。" },
    { "id": "auntie_hit_01", "archetype": "auntie", "trigger": "hit", "emotion": "sad", "text": "哎哟……我的腿……来人呐……", "instruct": "痛苦地呼救，声音虚弱。", "variants": 4 },
    { "id": "auntie_aimed_01", "archetype": "auntie", "trigger": "aimed", "emotion": "fearful", "text": "别开枪别开枪！我什么都没看见！", "instruct": "吓得语无伦次。" },
    { "id": "auntie_gunshot_01", "archetype": "auntie", "trigger": "gunshot", "emotion": "fearful", "text": "枪响了！快跑啊！", "instruct": "惊慌地大喊。" },
    { "id": "auntie_idle_01", "archetype": "auntie", "trigger": "idle", "emotion": "happy", "text": "一会儿跳完舞，去买俩西红柿。", "instruct": "心情不错地念叨。" },
    { "id": "auntie_idle_02", "archetype": "auntie", "trigger": "idle", "emotion": "neutral", "text": "这音响声儿怎么这么小。", "instruct": "嘟囔。" },
    { "id": "auntie_greet_01", "archetype": "auntie", "trigger": "greet", "emotion": "happy", "text": "哟，遛弯儿呢？", "instruct": "热络地搭话。" },
    { "id": "auntie_police_01", "archetype": "auntie", "trigger": "police_call", "emotion": "angry", "text": "警察同志！这儿有个疯子开车乱撞！", "instruct": "对着电话激动地喊。" },

    { "id": "courier_near_miss_01", "archetype": "courier", "trigger": "near_miss", "emotion": "surprised", "text": "哥们儿让让！我这单要超时了！", "instruct": "急匆匆地喊。" },
    { "id": "courier_near_miss_02", "archetype": "courier", "trigger": "near_miss", "emotion": "neutral", "text": "别挡道儿别挡道儿！", "instruct": "语速飞快。" },
    { "id": "courier_bumped_01", "archetype": "courier", "trigger": "bumped", "emotion": "angry", "text": "哎哟我车！我的餐！", "instruct": "心疼又着急。" },
    { "id": "courier_hit_01", "archetype": "courier", "trigger": "hit", "emotion": "sad", "text": "我的……我的订单……", "instruct": "虚弱地呻吟。", "variants": 4 },
    { "id": "courier_aimed_01", "archetype": "courier", "trigger": "aimed", "emotion": "fearful", "text": "大哥大哥，餐你拿走，别伤人！", "instruct": "紧张地求饶。" },
    { "id": "courier_gunshot_01", "archetype": "courier", "trigger": "gunshot", "emotion": "fearful", "text": "不干了不干了，这单不送了！", "instruct": "边跑边喊。" },
    { "id": "courier_idle_01", "archetype": "courier", "trigger": "idle", "emotion": "neutral", "text": "系统你倒是给我派个顺路的啊。", "instruct": "无奈地嘟囔。" },
    { "id": "courier_idle_02", "archetype": "courier", "trigger": "idle", "emotion": "neutral", "text": "还有三单，加油加油。", "instruct": "给自己打气。" },
    { "id": "courier_police_01", "archetype": "courier", "trigger": "police_call", "emotion": "surprised", "text": "喂警察吗？四环辅路有人开车撞人，车牌我没看清！", "instruct": "气喘吁吁地报警。" },

    { "id": "office_near_miss_01", "archetype": "office", "trigger": "near_miss", "emotion": "surprised", "text": "我去……差点儿。", "instruct": "惊魂未定，低声。" },
    { "id": "office_near_miss_02", "archetype": "office", "trigger": "near_miss", "emotion": "angry", "text": "有病吧你！", "instruct": "冲着车尾骂。" },
    { "id": "office_bumped_01", "archetype": "office", "trigger": "bumped", "emotion": "angry", "text": "看着点儿行吗？我赶时间。", "instruct": "不耐烦。" },
    { "id": "office_hit_01", "archetype": "office", "trigger": "hit", "emotion": "sad", "text": "我的……电脑……", "instruct": "虚弱地呻吟。", "variants": 4 },
    { "id": "office_aimed_01", "archetype": "office", "trigger": "aimed", "emotion": "fearful", "text": "别别别，手机钱包都给你，别伤我。", "instruct": "害怕地求饶。" },
    { "id": "office_gunshot_01", "archetype": "office", "trigger": "gunshot", "emotion": "fearful", "text": "什么声音？快撤快撤！", "instruct": "慌张。" },
    { "id": "office_idle_01", "archetype": "office", "trigger": "idle", "emotion": "sad", "text": "今晚又得加班……", "instruct": "有气无力地叹气。" },
    { "id": "office_idle_02", "archetype": "office", "trigger": "idle", "emotion": "disgusted", "text": "这破会开到几点啊。", "instruct": "烦躁地抱怨。" },
    { "id": "office_police_01", "archetype": "office", "trigger": "police_call", "emotion": "fearful", "text": "一一零吗？朝阳区这边有人持枪！", "instruct": "压低声音紧张地报警。" },

    { "id": "tourist_near_miss_01", "archetype": "tourist", "trigger": "near_miss", "emotion": "surprised", "text": "我的天！北京开车都这样吗？", "instruct": "震惊。" },
    { "id": "tourist_bumped_01", "archetype": "tourist", "trigger": "bumped", "emotion": "surprised", "text": "哎呀对不起对不起……咦，是你撞的我啊！", "instruct": "先道歉，后反应过来，语气转变。" },
    { "id": "tourist_hit_01", "archetype": "tourist", "trigger": "hit", "emotion": "sad", "text": "我……我还没去故宫呢……", "instruct": "虚弱地呻吟。", "variants": 4 },
    { "id": "tourist_aimed_01", "archetype": "tourist", "trigger": "aimed", "emotion": "fearful", "text": "别！我是来旅游的！", "instruct": "害怕地喊。" },
    { "id": "tourist_gunshot_01", "archetype": "tourist", "trigger": "gunshot", "emotion": "surprised", "text": "是不是拍电影啊？……不对，快跑！", "instruct": "从好奇到惊慌。" },
    { "id": "tourist_idle_01", "archetype": "tourist", "trigger": "idle", "emotion": "neutral", "text": "这桥叫什么桥来着？", "instruct": "好奇地自问。" },
    { "id": "tourist_idle_02", "archetype": "tourist", "trigger": "idle", "emotion": "happy", "text": "来来来，往这边看，笑一个！", "instruct": "兴奋地招呼同伴拍照。" },
    { "id": "tourist_greet_01", "archetype": "tourist", "trigger": "greet", "emotion": "happy", "text": "师傅，请问去三里屯怎么走？", "instruct": "礼貌地问路。" },

    { "id": "guard_near_miss_01", "archetype": "guard", "trigger": "near_miss", "emotion": "angry", "text": "哎！哎！这儿不让开这么快！", "instruct": "吹完哨子大声制止。" },
    { "id": "guard_bumped_01", "archetype": "guard", "trigger": "bumped", "emotion": "angry", "text": "干什么的！出示一下证件！", "instruct": "公事公办地呵斥。" },
    { "id": "guard_hit_01", "archetype": "guard", "trigger": "hit", "emotion": "sad", "text": "哎哟……队长……我不行了……", "instruct": "痛苦地呻吟。", "variants": 4 },
    { "id": "guard_aimed_01", "archetype": "guard", "trigger": "aimed", "emotion": "fearful", "text": "兄弟，我就一看门儿的，别冲动……", "instruct": "强装镇定但声音发抖。" },
    { "id": "guard_gunshot_01", "archetype": "guard", "trigger": "gunshot", "emotion": "fearful", "text": "都别过来！都别过来！", "instruct": "色厉内荏地大喊。" },
    { "id": "guard_idle_01", "archetype": "guard", "trigger": "idle", "emotion": "neutral", "text": "这班站到几点啊。", "instruct": "无聊地嘟囔。" },
    { "id": "guard_idle_02", "archetype": "guard", "trigger": "idle", "emotion": "neutral", "text": "外来车辆登记一下啊。", "instruct": "例行公事的腔调。" },
    { "id": "guard_greet_01", "archetype": "guard", "trigger": "greet", "emotion": "neutral", "text": "您好，您找哪位？", "instruct": "客气但带着审视。" },
    { "id": "guard_police_01", "archetype": "guard", "trigger": "police_call", "emotion": "angry", "text": "喂，派出所吗？这儿有人闹事，开车撞人！", "instruct": "对着对讲机大声报告。" },

    { "id": "driver_honk_01", "archetype": "driver", "trigger": "honk", "emotion": "angry", "text": "会不会开车啊！", "instruct": "摇下车窗骂。" },
    { "id": "driver_honk_02", "archetype": "driver", "trigger": "honk", "emotion": "angry", "text": "倒是走啊！后面排长队了！", "instruct": "不耐烦地催。" },
    { "id": "driver_near_miss_01", "archetype": "driver", "trigger": "near_miss", "emotion": "angry", "text": "嘿！加塞儿是吧？", "instruct": "火冒三丈。" },
    { "id": "driver_car_stolen_01", "archetype": "driver", "trigger": "car_stolen", "emotion": "angry", "text": "我车！站住！我车！", "instruct": "边追边喊，气急败坏。" },
    { "id": "driver_car_stolen_02", "archetype": "driver", "trigger": "car_stolen", "emotion": "angry", "text": "哎哎哎，那是我的车！警察！警察！", "instruct": "扯着嗓子喊。" },
    { "id": "driver_car_stolen_03", "archetype": "driver", "trigger": "car_stolen", "emotion": "sad", "text": "完了完了……这月车贷还没还呢……", "instruct": "追不上了，绝望地喘气。" },
    { "id": "driver_idle_01", "archetype": "driver", "trigger": "idle", "emotion": "neutral", "text": "这路堵的，到地方得天黑。", "instruct": "唠叨。" },
    { "id": "driver_police_01", "archetype": "driver", "trigger": "police_call", "emotion": "angry", "text": "喂，交警吗？有人抢车！往东去了！", "instruct": "气喘吁吁地报警。" }
